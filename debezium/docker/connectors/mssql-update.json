{
  "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
  "tasks.max": "1",

  "database.hostname": "<host>",
  "database.port": "1433",
  "database.user": "<username>",
  "database.password": "<password>",
  "database.names": "db1",
  "database.trustServerCertificate": "true",
  "driver.applicationIntent": "ReadOnly",

  "topic.prefix": "cdc.source",
  "topic.heartbeat.prefix": "__heartbeat.source",
  "heartbeat.interval.ms": "60000",
  "schema.include.list": "dbo",
  "table.include.list": "dbo.Loan",

  "snapshot.mode": "initial",
  "snapshot.locking.mode": "none",
  "snapshot.database.errors.max.retries": "3",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",
  "decimal.handling.mode": "precise",
  "time.precision.mode": "adaptive",
  "schema.name.adjustment.mode": "avro",

  "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
  "schema.history.internal.kafka.topic": "__history.source",
  "schema.history.internal.store.only.captured.tables.ddl": "true",

  "signal.enabled.channels": "kafka",
  "signal.kafka.bootstrap.servers": "kafka:9092",
  "signal.kafka.topic": "__signal.source",
  "signal.kafka.groupId": "signal-source",

  "key.converter": "io.apicurio.registry.utils.converter.AvroConverter",
  "key.converter.schemas.enable": "false",
  "key.converter.apicurio.registry.url": "http://host.docker.internal:8888/apis/registry/v3",
  "key.converter.apicurio.registry.artifact.group-id": "source",
  "key.converter.apicurio.registry.auto-register": "false",
  "key.converter.apicurio.registry.find-latest": "true",
  "key.converter.apicurio.registry.as-confluent": "true",
  "key.converter.apicurio.registry.headers.enabled": "false",
  "key.converter.apicurio.registry.use-id": "contentId",

  "value.converter": "io.apicurio.registry.utils.converter.AvroConverter",
  "value.converter.schemas.enable": "false",
  "value.converter.apicurio.registry.url": "http://host.docker.internal:8888/apis/registry/v3",
  "value.converter.apicurio.registry.artifact.group-id": "source",
  "value.converter.apicurio.registry.auto-register": "false",
  "value.converter.apicurio.registry.find-latest": "true",
  "value.converter.apicurio.registry.as-confluent": "true",
  "value.converter.apicurio.registry.headers.enabled": "false",
  "value.converter.apicurio.registry.use-id": "contentId",

  "errors.tolerance": "none",
  "errors.log.enable": "true",
  "errors.log.include.messages": "true",
  "errors.retry.timeout": "300000",
  "errors.retry.delay.max.ms": "60000"
}
