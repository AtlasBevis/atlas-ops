AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2

# Copy to .env on the VM: cp .env.example .env
AIRFLOW_UID=50000

# External PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:5432/<db>
AIRFLOW_DB_CONN=postgresql+psycopg2://airflow:airflow@10.0.0.10:5432/airflow

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=change-me

AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_PARALLELISM=32

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Set True after creating connection minio_conn
AIRFLOW_REMOTE_LOGGING=False
